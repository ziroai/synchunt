# ============================================
# SyncHunt - .gitignore
# ============================================

# Scan output (can be huge + contains sensitive findings)
output/
*.db

# Python cache / test artifacts
__pycache__/
*.py[cod]
*.pyo
*.pyd
.Python
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
htmlcov/

# Virtual environments
venv/
env/
.venv/
.env/
.env

# Environment / secrets files
*.env
secrets.yaml

# Logs
*.log
logs/

# OS files
.DS_Store
Thumbs.db
desktop.ini

# IDE
.vscode/
.idea/
*.swp
*.swo

# Temp / scratch
*.tmp
*.bak
*.backup

# Compiled
*.so
*.egg
*.egg-info/
dist/
build/

# Wordlists (too large for git, install separately)
wordlists/*.txt

# Keep the wordlists folder structure
!wordlists/.gitkeep
